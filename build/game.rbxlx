      <Item class="Script" referent="10">
        <Properties>
          <string name="Name">Coins</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("Remotes"))

local function award(plr: Player, amount: number)
	local current = plr:GetAttribute("Coins") or 0
	if typeof(current) ~= "number" then
		current = 0
	end
	local nextVal = (current :: number) + amount
	plr:SetAttribute("Coins", nextVal)
	Remotes.CoinCollected:FireClient(plr, nextVal)
end

local function hookCoin(part: BasePart)
	local taken = false
	part.Touched:Connect(function(hit: BasePart)
		if taken then
			return
		end
		local char = hit.Parent
		if not char then
			return
		end
		local plr = Players:GetPlayerFromCharacter(char)
		if not plr then
			return
		end
		taken = true
		award(plr, 1)
		part:Destroy()
	end)
end

local folder = workspace:FindFirstChild("Coins")
if folder then
	for _, child in ipairs(folder:GetChildren()) do
		if child:IsA("BasePart") then
			hookCoin(child)
		end
	end
	folder.ChildAdded:Connect(function(child)
		if child:IsA("BasePart") then
			hookCoin(child)
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="11">
        <Properties>
          <string name="Name">Puzzles</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- MVP pressure plate: stand on Plate opens Gate (Transparency + CanCollide).
local Players = game:GetService("Players")

local folder = workspace:FindFirstChild("Puzzles")
if not folder then
	folder = Instance.new("Folder")
	folder.Name = "Puzzles"
	folder.Parent = workspace
end

-- Positions match Generator floor top Y=5 (on the path, toward −Z).
local plate = folder:FindFirstChild("PressurePlate")
if not plate then
	plate = Instance.new("Part")
	plate.Name = "PressurePlate"
	plate.Size = Vector3.new(6, 1, 6)
	plate.Position = Vector3.new(8, 5.5, -30)
	plate.Anchored = true
	plate.Color = Color3.fromRGB(80, 80, 200)
	plate.Parent = folder
end

local gate = folder:FindFirstChild("Gate")
if not gate then
	gate = Instance.new("Part")
	gate.Name = "Gate"
	gate.Size = Vector3.new(10, 12, 1)
	gate.Position = Vector3.new(8, 11, -40)
	gate.Anchored = true
	gate.Color = Color3.fromRGB(180, 60, 60)
	gate.Parent = folder
end

assert(plate:IsA("BasePart") and gate:IsA("BasePart"))

local standing = 0
local lastTouch = 0.0

local function setOpen(open: boolean)
	gate.CanCollide = not open
	gate.Transparency = if open then 0.7 else 0
end

plate.Touched:Connect(function(hit: BasePart)
	local char = hit.Parent
	if not char then
		return
	end
	local plr = Players:GetPlayerFromCharacter(char)
	if not plr then
		return
	end
	local now = os.clock()
	if now - lastTouch < 0.05 then
		return
	end
	lastTouch = now
	standing += 1
	setOpen(true)
end)

plate.TouchEnded:Connect(function(hit: BasePart)
	local char = hit.Parent
	if not char then
		return
	end
	if not Players:GetPlayerFromCharacter(char) then
		return
	end
	standing = math.max(0, standing - 1)
	if standing == 0 then
		setOpen(false)
	end
end)

print("[Puzzles] pressure plate ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Void</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Soft void: if HRP falls below Y=-20, LoadCharacter (respawn uses Checkpoints hooks).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local VOID_Y = -20

local function watch(plr: Player, char: Model)
	local hrp = char:WaitForChild("HumanoidRootPart", 5)
	if not hrp or not hrp:IsA("BasePart") then
		return
	end
	local conn: RBXScriptConnection? = nil
	conn = RunService.Heartbeat:Connect(function()
		if not plr.Parent or not char.Parent then
			if conn then
				conn:Disconnect()
			end
			return
		end
		if hrp.Position.Y < VOID_Y then
			if conn then
				conn:Disconnect()
			end
			plr:LoadCharacter()
		end
	end)
end

local function hook(plr: Player)
	plr.CharacterAdded:Connect(function(char)
		watch(plr, char)
	end)
	if plr.Character then
		watch(plr, plr.Character)
	end
end

Players.PlayerAdded:Connect(hook)
for _, plr in ipairs(Players:GetPlayers()) do
	hook(plr)
end
]]></string>
        </Properties>
      </Item>
