          <string name="Name">Effects</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Remotes = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("Remotes"))

local function play(soundId: string, volume: number)
	local s = Instance.new("Sound")
	s.SoundId = soundId
	s.Volume = volume
	s.Parent = SoundService
	s:Play()
	s.Ended:Connect(function()
		s:Destroy()
	end)
end

Remotes.CheckpointReached.OnClientEvent:Connect(function()
	play("rbxassetid://9112854440", 0.5)
	local gui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
	if not gui then
		return
	end
	local hud = gui:FindFirstChild("HUD")
	if not hud then
		return
	end
	local cp = hud:FindFirstChild("CheckpointCount")
	if cp and cp:IsA("GuiObject") then
		local tween = TweenService:Create(
			cp,
			TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ BackgroundTransparency = 0.1 }
		)
		tween:Play()
		tween.Completed:Connect(function()
			TweenService:Create(
				cp,
				TweenInfo.new(0.3),
				{ BackgroundTransparency = 0.5 }
			):Play()
		end)
	end
end)

if Remotes.CoinCollected then
	Remotes.CoinCollected.OnClientEvent:Connect(function()
		play("rbxassetid://9114224690", 0.4)
		local gui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
		local hud = gui and gui:FindFirstChild("HUD")
		local coin = hud and hud:FindFirstChild("CoinCount")
		if coin and coin:IsA("GuiObject") then
			local tween = TweenService:Create(
				coin,
				TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ BackgroundTransparency = 0.1 }
			)
			tween:Play()
			tween.Completed:Connect(function()
				TweenService:Create(coin, TweenInfo.new(0.3), { BackgroundTransparency = 0.5 }):Play()
			end)
		end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">HUD</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui")

local screen = Instance.new("ScreenGui")
screen.Name = "HUD"
screen.ResetOnSpawn = false
screen.Parent = gui

local function makeLabel(name: string, text: string, y: number): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Text = text
	label.Size = UDim2.new(0, 200, 0, 40)
	label.Position = UDim2.new(0.5, -100, 0, y)
	label.BackgroundTransparency = 0.5
	label.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextScaled = true
	label.Parent = screen
	return label
end

local timer = makeLabel("Timer", "Time: 0s", 10)
local cpLabel = makeLabel("CheckpointCount", "CP: 0", 60)
local coinLabel = makeLabel("CoinCount", "Coins: 0", 110)
local bestLabel = makeLabel("BestTime", "Best: --", 160)

task.spawn(function()
	local start = tick()
	while true do
		task.wait(1)
		timer.Text = string.format("Time: %ds", math.floor(tick() - start))
		local best = player:GetAttribute("BestTime")
		if typeof(best) == "number" and (best :: number) > 0 then
			bestLabel.Text = string.format("Best: %ds", math.floor(best :: number))
		end
	end
end)

local Remotes = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("Remotes"))
Remotes.CheckpointReached.OnClientEvent:Connect(function(idx)
	cpLabel.Text = "CP: " .. tostring(idx)
end)
if Remotes.CoinCollected then
	Remotes.CoinCollected.OnClientEvent:Connect(function(total)
		coinLabel.Text = "Coins: " .. tostring(total)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="21">
        <Properties>
          <string name="Name">Leaderboard</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local gui = player:WaitForChild("PlayerGui")

local screen = Instance.new("ScreenGui")
screen.Name = "LeaderboardGui"
screen.ResetOnSpawn = false
screen.Parent = gui

local label = Instance.new("TextLabel")
label.Name = "Leaderboard"
label.Size = UDim2.new(0, 220, 0, 120)
label.Position = UDim2.new(0, 10, 0.5, -60)
label.BackgroundTransparency = 0.4
label.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
label.TextColor3 = Color3.new(1, 1, 1)
label.TextXAlignment = Enum.TextXAlignment.Left
label.TextYAlignment = Enum.TextYAlignment.Top
label.TextScaled = false
label.TextSize = 16
label.Text = "Leaderboard\n(waiting...)"
label.Parent = screen

local Remotes = require(ReplicatedStorage:WaitForChild("Gameplay"):WaitForChild("Remotes"))
if Remotes.UpdateLeaderboard then
	Remotes.UpdateLeaderboard.OnClientEvent:Connect(function(payload)
		if typeof(payload) == "string" then
			label.Text = "Leaderboard\n" .. payload
		elseif typeof(payload) == "table" then
			local lines = { "Leaderboard" }
			for i, row in ipairs(payload) do
				table.insert(lines, string.format("%d. %s", i, tostring(row)))
			end
			label.Text = table.concat(lines, "\n")
		end
	end)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>