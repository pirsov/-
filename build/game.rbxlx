  <Item class="ServerScriptService" referent="3">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Data</string>
      </Properties>
      <Item class="Script" referent="5">
        <Properties>
          <string name="Name">PlayerData</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
local DataStoreService = game:GetService("DataStoreService")
local playerDataStore = DataStoreService:GetDataStore("PlayerData")

local function onPlayerAdded(player)
    local success, result = pcall(function()
        local data = playerDataStore:GetAsync(player.UserId)
        if data then
            player:SetAttribute("Score", data.Score)
        else
            player:SetAttribute("Score", 0)
        end
    end)
    if not success then
        warn("Failed to load player data: " .. result)
    end

    player.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid")
        humanoid.Died:Connect(function()
            local score = player:GetAttribute("Score")
            pcall(function()
                playerDataStore:SetAsync(player.UserId, {Score = score})
            end)
        end)
    end)
end

game.Players.PlayerAdded:Connect(onPlayerAdded)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Gameplay</string>
      </Properties>
      <Item class="Script" referent="7">
        <Properties>
          <string name="Name">Checkpoints</string>
          <token name="RunContext">0</token>
          <string name="Source">--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")

local CheckpointDataStore = DataStoreService:GetDataStore("CheckpointData")

local Checkpoints = {}

local function onPlayerAdded(player)
    local checkpoints = Checkpoints
    player.Checkpoints = checkpoints

    for i, checkpoint in ipairs(checkpoints) do
        checkpoint.Touched:Connect(function(hit)
            local character = hit.Parent
            if character and character:IsA("Model") and character:FindFirstChild("Humanoid") then
                local humanoid = character:FindFirstChild("Humanoid")
                if humanoid.Health &gt; 0 then
                    local checkpointData = CheckpointDataStore:GetAsync(player.UserId)
                    if not checkpointData then
                        checkpointData = {}
                    end

                    checkpointData[i] = true
                    CheckpointDataStore:SetAsync(player.UserId, checkpointData)

                    ReplicatedStorage.Remotes.CheckpointReached:FireClient(player, i)
                end
            end
        end)
    end

    player.CharacterAdded:Connect(function(character)
        local humanoid = character:WaitForChild("Humanoid")
        humanoid.Died:Connect(function()
            local checkpointData = CheckpointDataStore:GetAsync(player.UserId)
            if checkpointData then
                for i = 1, #checkpoints do
                    if checkpointData[i] then
                        character:SetPrimaryPartCFrame(checkpoints[i].CFrame)
                        break
                    end
                end
            end
        end)
    end)
end

Players.PlayerAdded:Connect(onPlayerAdded)</string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">Level</string>
