{
  "id": "network_remote",
  "version": "v1",
  "required": ["getOrCreate", "RemoteEvent", "return"],
  "required_any": [["CheckpointReached", "CoinCollected"]],
  "forbid": ["DataStoreService", "LocalPlayer", "FireServer"],
  "forbid_regex": ["Remotes\\.CoinsCollected\\b"],
  "prompt_budget_chars": 500,
  "default_path_glob": "src/shared/Gameplay/Remotes.luau",
  "path_hints": ["Remotes.luau", "Gameplay/Remotes"]
}
