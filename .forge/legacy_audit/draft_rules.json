    {
      "id": "R002",
      "source": "legacy_audit",
      "plugin": "legacy.audit",
      "human_comment": "Client FireServer — ensure server validates args — Any client can spoof FireServer args. Server must validate pack/price/ownership.",
      "match": {
        "archetypes": [
          "datastore_service",
          "server_script"
        ]
      },
      "checks": [
        {
          "type": "require_regex",
          "msg": "HITL/legacy: OnServerEvent handlers must validate args (typeof/assert)",
          "pattern": "OnServerEvent[\\s\\S]{0,400}(?:typeof|assert|if\\s+typeof)"
        }
      ],
      "status": "draft",
      "created_at": "2026-11-10T12:00:05.308509+00:00",
      "from_pitfall": "P002",
      "severity": "med",
      "evidence_file": "ShopUI.client.luau"
    },
    {
      "id": "R003",
      "source": "legacy_audit",
      "plugin": "legacy.audit",
      "human_comment": "GetPlayerFromCharacter without nil guard — Character may be orphaned after leave; nil player crashes handlers.",
      "match": {
        "archetypes": [
          "server_script",
          "client_ui"
        ]
      },
      "checks": [
        {
          "type": "forbid_regex",
          "msg": "HITL/legacy: nil-check player from GetPlayerFromCharacter",
          "pattern": "GetPlayerFromCharacter\\s*\\([^)]*\\)\\s*\\n(?!\\s*if\\b)"
        }
      ],
      "status": "draft",
      "created_at": "2026-11-10T12:00:05.308518+00:00",
      "from_pitfall": "P003",
      "severity": "med",
      "evidence_file": "Checkpoints.server.luau"
    },
    {
      "id": "R004",
      "source": "legacy_audit",
      "plugin": "legacy.audit",
      "human_comment": "DataStore GetAsync without pcall — DataStore failures throw; without pcall the script dies and progress is lost.",
      "match": {
        "archetypes": [
          "datastore_service",
          "server_script"
        ]
      },
      "checks": [
        {
          "type": "require_regex",
          "msg": "HITL/legacy: wrap DataStore GetAsync in pcall",
          "pattern": "\\bpcall\\s*\\("
        }
      ],
      "status": "draft",
      "created_at": "2026-11-10T12:00:05.308523+00:00",
      "from_pitfall": "P004",
      "severity": "crit",
      "evidence_file": "PlayerData.server.luau"
    },
    {
      "id": "R005",
      "source": "legacy_audit",
      "plugin": "legacy.audit",
      "human_comment": "while true do without wait — Tight loop freezes the Luau VM / hangs the server or client.",
      "match": {
        "archetypes": [
          "server_script",
          "client_ui",
          "datastore_service"
        ]
      },
      "checks": [
        {
          "type": "forbid_regex",
          "msg": "HITL/legacy: while true do must include task.wait/wait",
          "pattern": "while\\s+true\\s+do(?![\\s\\S]{0,400}\\b(?:task\\.wait|wait)\\s*\\()"
        }
      ],
      "status": "draft",
      "created_at": "2026-11-10T12:00:05.308529+00:00",
      "from_pitfall": "P006",
      "severity": "high",
      "evidence_file": "PlayerData.server.luau"
    },
    {
      "id": "R006",
      "source": "legacy_audit",
      "plugin": "legacy.audit",
      "human_comment": "OnServerEvent handler without arg validation — Missing typeof/assert opens an exploit path (free items, illegal packs).",
      "match": {
        "archetypes": [
          "datastore_service",
          "server_script"
        ]
      },
      "checks": [
        {
          "type": "require_regex",
          "msg": "HITL/legacy: validate RemoteEvent args on server",
          "pattern": "OnServerEvent[\\s\\S]{0,500}(?:typeof|assert)"
        }
      ],
      "status": "draft",
      "created_at": "2026-11-10T12:00:05.308535+00:00",
      "from_pitfall": "P007",
      "severity": "high",
      "evidence_file": "Shop.server.luau"
    },
    {
      "id": "R007",
      "source": "legacy_audit",
      "plugin": "legacy.audit",
      "human_comment": "Deprecated wait() — use task.wait — Global wait is throttled/deprecated; prefer task.wait.",
      "match": {
        "archetypes": [
          "server_script",
          "client_ui",
          "datastore_service"
        ]
      },
      "checks": [
        {
          "type": "forbid_regex",
          "msg": "HITL/legacy: use task.wait, not wait",
          "pattern": "(?<![\\w.])wait\\s*\\("
        }
      ],
      "status": "draft",
      "created_at": "2026-11-10T12:00:05.308539+00:00",
      "from_pitfall": "P008",
